# Publishing credentials. NEVER commit real values.
# Keep this file as documentation only.

# npmjs
NPM_TOKEN=replace-with-npm-access-token

# GitLab Package Registry
GITLAB_TOKEN=replace-with-gitlab-token
GITLAB_PROJECT_ID=replace-with-project-id
GITLAB_API_V4_URL=https://gitlab.com/api/v4

# In GitLab CI, prefer the built-in variables:
# CI_JOB_TOKEN
# CI_PROJECT_ID
# CI_API_V4_URL
