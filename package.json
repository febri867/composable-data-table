{
  "name": "coconut-composable-data-table",
  "private": false,
  "version": "0.1.11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "docs": "vite",
    "docs:build": "vite build",
    "docs:api": "typedoc",
    "build:package": "npm run clean:package && tsc -p tsconfig.lib.json && vite build -c vite.library.config.ts",
    "clean:package": "node -e \"const fs=require('node:fs'); fs.rmSync('dist',{recursive:true,force:true})\"",
    "pack": "npm run build:package && npm pack --pack-destination artifacts",
    "publish:npm": "node scripts/publish.mjs npm",
    "publish:gitlab": "node scripts/publish.mjs gitlab",
    "ci": "npm run typecheck && npm run lint && npm test && npm run build && npm run build:package",
    "prepublishOnly": "npm run build:package",
    "publish:check": "node scripts/publish.mjs check"
  },
  "dependencies": {
    "@tanstack/react-table": "8.21.3",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@storybook/addon-a11y": "^9.1.0",
    "@storybook/addon-docs": "^9.1.0",
    "@storybook/react-vite": "^9.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "storybook": "^9.1.0",
    "typedoc": "^0.28.7",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^3.2.4"
  },
  "description": "Composable, accessible React data table primitives.",
  "license": "MIT",
  "sideEffects": [
    "dist/styles.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "keywords": [
    "react",
    "typescript",
    "data-table",
    "table",
    "component-library",
    "headless",
    "composable",
    "accessible"
  ]
}
