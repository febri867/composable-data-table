# Publishing environment template.
# Copy to .env.publish.local and fill in real values.
# NEVER commit real credentials.

# npmjs.org
NPM_TOKEN=replace-with-npm-access-token

# GitLab Package Registry
GITLAB_TOKEN=replace-with-gitlab-token
GITLAB_PROJECT_ID=replace-with-gitlab-project-id
GITLAB_API_V4_URL=https://gitlab.com/api/v4

# In GitLab CI, the following are provided automatically and can be used
# instead of GITLAB_TOKEN / GITLAB_PROJECT_ID / GITLAB_API_V4_URL:
# CI_JOB_TOKEN=
# CI_PROJECT_ID=
# CI_API_V4_URL=
